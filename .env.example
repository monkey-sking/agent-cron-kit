# 投递渠道（不需要就留空）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 本地状态目录（去重记录、outbox、日志）
CRON_KIT_STATE_DIR=~/.local/state/cron-kit

# git-guard：要巡检/推送的仓库根目录（多个用冒号分隔），或写一个仓库清单文件
CRON_KIT_GIT_ROOTS=~/dev/Projects
CRON_KIT_GIT_REPOS_FILE=~/.config/cron-kit/repos.txt

# network-watchdog / proxy-watchdog：Clash / Mihomo 控制接口
CLASH_API=http://127.0.0.1:9090
CLASH_SECRET=
CLASH_RESTART_CMD=

# proxy-watchdog：进程匹配、配置目录与 App 名（macOS）
PROXY_CORE_PATTERN=mihomo|ClashMac/core/current
PROXY_PROFILES_DIR=
PROXY_WORK_DIR=
PROXY_APP_NAME=
